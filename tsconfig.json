{
  // Type-checks the CLI and the catalog's JavaScript; esbuild does the build.
  // Imports name a module without an extension, as a bundler resolves them.
  // The catalog stays JavaScript because it is copied into projects and run
  // there with plain node; its types are JSDoc. tests/tsconfig.json checks
  // the tests.
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "allowJs": true,
    "checkJs": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src", "catalog", "vitest.config.ts"]
}
