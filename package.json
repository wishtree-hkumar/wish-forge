{
  "name": "wish-forge",
  "version": "0.1.0",
  "description": "Ready-to-use coding agents and development flows for Claude Code, Codex, OpenCode and Cursor.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "wishforge": "./dist/bin.js"
  },
  "files": [
    "dist",
    "catalog",
    "README.md"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json && node -e \"require('fs').chmodSync('dist/bin.js', 0o755)\"",
    "typecheck": "tsc -p tsconfig.json && tsc -p tests",
    "prepare": "npm run build",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint src tests catalog",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "oxlint": "^1.75.0",
    "prettier": "^3.6.2",
    "smol-toml": "^1.9.1",
    "typescript": "^7.0.2",
    "vitest": "4.1.10"
  }
}
